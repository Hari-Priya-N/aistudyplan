# ============================================================
# Backend environment config — for running WITHOUT Docker
# (see ../.env.example for the Docker Compose version).
# Copy to backend/.env — never commit the real .env file.
# ============================================================

# ---- LLM provider selection ----
# One of: grok | openai | gemini | ollama | mock
#   ollama = fully LOCAL model (no data leaves your machine)
#   gemini / grok / openai = PUBLIC cloud APIs (need a key)
#   mock   = needs no API key at all — fastest way to try the app
LLM_PROVIDER=mock
LLM_MODEL=mock-1

# ---- Provider credentials (only the selected provider's key is required) ----
GROK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: any OpenAI-compatible server (Groq, Together, vLLM, LM Studio...)
OPENAI_BASE_URL=

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
# SQLite for local dev (no Postgres server needed):
DATABASE_URL=sqlite:///./tutor.db
# Or point at a local/remote Postgres:
# DATABASE_URL=postgresql://tutor_user:tutor_pass@localhost:5432/tutor_db

# ---- Redis (optional locally — leave blank to skip session caching) ----
REDIS_URL=

# ---- ChromaDB ----
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./data/chroma

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Student limits & motivation ----
ALLOW_STUDENT_UPLOADS=false     # students see the upload page greyed out
CHAT_DAILY_QUOTA=20             # Elara messages per student per day
REDEEM_COST_POINTS=20           # points to unlock extra Elara messages
REDEEM_BONUS_MESSAGES=5
APP_TIMEZONE=Asia/Kolkata

# ---- Bootstrap ----
SEED_DEMO=false                 # true = create demo school data + demo logins on first start
ADMIN_EMAIL=                    # creates a Management account on start
ADMIN_PASSWORD=
