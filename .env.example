# ============================================================
# Personalized Learning Path Generator — environment config
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is already in .gitignore).
# ============================================================

# ---- LLM provider selection ----
# One of: grok | openai | gemini | ollama | mock
#   ollama = fully LOCAL model (no data leaves your server) — see docs/CODE_DOCUMENTATION.md
#   gemini / grok / openai = PUBLIC cloud APIs (need a key)
#   mock   = no AI at all, deterministic placeholder output (demos / tests)
LLM_PROVIDER=grok

# Model name used for the selected provider
# grok example:   grok-2-latest
# openai example: gpt-4o
# ollama example: llama3
LLM_MODEL=grok-2-latest

# ---- Provider credentials (only the selected provider's key is required) ----
GROK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: any OpenAI-compatible server (Groq, Together, vLLM, LM Studio...)
OPENAI_BASE_URL=

# Ollama (local, no key needed) — base URL of your local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://tutor_user:tutor_pass@postgres:5432/tutor_db
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=tutor_pass
POSTGRES_DB=tutor_db

# ---- Redis (session cache) ----
REDIS_URL=redis://redis:6379/0

# ---- ChromaDB (vector store) ----
# "embedded" runs Chroma in-process with a local persistent directory (default, simplest).
# "http" connects to a separate Chroma server (set CHROMA_HOST/CHROMA_PORT).
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=/data/chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Student limits & motivation ----
ALLOW_STUDENT_UPLOADS=false     # students see the upload page greyed out
CHAT_DAILY_QUOTA=20             # Elara messages per student per day
REDEEM_COST_POINTS=20           # points to unlock extra Elara messages
REDEEM_BONUS_MESSAGES=5
APP_TIMEZONE=Asia/Kolkata

# ---- Bootstrap ----
SEED_DEMO=false                 # true = create demo school data + demo logins on first start
ADMIN_EMAIL=                    # creates a Management account on start
ADMIN_PASSWORD=
